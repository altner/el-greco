---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import MenuPage from '../components/MenuPage.astro';
import MenuSection from '../components/MenuSection.astro';
import MenuItem from '../components/MenuItem.astro';
import WineItem from '../components/WineItem.astro';
import '../styles/global.css';
import BottomNav from '../components/BottomNav.astro';
import BackToTop from '../components/BackToTop.astro';
import { CONTACT } from '../data/contact';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="El Greco — Speisekarte">

  <!-- HERO -->
  <section id="hero" class="max-h-[28dvh] md:max-h-[40dvh] flex flex-col items-center justify-center py-6 md:py-8 px-4 overflow-hidden" style="background:#7e8e6d;">

    <img src={`${base}/EL GRECO.png`} alt="El Greco — Griechisches Restaurant" class="w-full max-w-[200px] md:max-w-[320px] max-h-full object-contain" />
  </section>

  <NavBar />

  <!-- ÜBER UNS -->
  <section id="ueber-uns" class="md:min-h-[52dvh] flex flex-col items-center justify-center gap-6 px-6 py-6" style="background: var(--paper);">
    <div class="w-full max-w-xl">
      <h2
        class="font-serif font-medium italic text-center leading-tight mb-1"
        style="font-size: clamp(28px, 3.5vw, 38px); color: var(--olive-900); letter-spacing: 0.005em;"
      >
        Die Inspiration hinter unserem Namen
      </h2>
      <div class="w-8 h-px mx-auto my-3" style="background: var(--olive-500);"></div>
      <div class="space-y-3 font-serif font-medium text-[19px] leading-[1.55]" style="color: var(--ink-soft);">
        <p>Der Name EL GRECO geht auf den berühmten Maler Dominikos Theotokópoulos zurück. Er wurde im 16. Jahrhundert auf Kreta geboren und wirkte später vor allem in Spanien. Dort erhielt er den Beinamen „El Greco" – „der Grieche".</p>
        <p>Bis heute gilt El Greco als einer der bedeutendsten Künstler seiner Zeit. Seine Werke verbanden griechische Herkunft, mediterrane Kultur und europäische Kunst zu etwas Eigenständigem.</p>
        <p>EL GRECO steht für Kultur, Gastfreundschaft und die Liebe zu authentischer griechischer Küche – warm, herzlich und voller Geschmack.</p>
      </div>
    </div>

    <!-- Entdecken button -->
    <a
      href="#mittagskarte"
      class="inline-flex items-center gap-3 font-sans text-[12px] tracking-[0.16em] uppercase transition-all duration-200 flex-shrink-0"
      style="color: var(--ink-soft); border: 1px solid var(--rule); padding: 11px 28px; border-radius: 2px;"
      onmouseover="this.style.color='var(--ink)'; this.style.borderColor='var(--ink-soft)';"
      onmouseout="this.style.color='var(--ink-soft)'; this.style.borderColor='var(--rule)';"
      aria-label="Zur Speisekarte"
    >
      Speisekarte entdecken
      <svg width="14" height="9" viewBox="0 0 14 9" fill="none" aria-hidden="true">
        <path d="M1 1L7 7L13 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
    </a>
  </section>

