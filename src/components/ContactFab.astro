---
import { CONTACT } from '../data/contact';
---

{/* Mobile FAB-Gruppe: schwebt rechts unten, über der BottomNav. Nur md:hidden. */}
<div
  class="fixed md:hidden z-40 flex items-center gap-3"
  style="right: 16px; bottom: calc(64px + 16px + env(safe-area-inset-bottom, 0px));"
  aria-label="Reservierung"
>
  {/* Mail - sekundär, hell */}
  <a
    href={CONTACT.emailHref}
    class="fab-mail flex items-center justify-center rounded-full transition-transform duration-150 active:scale-95"
    style="width: 48px; height: 48px; background: var(--paper); color: oklch(0.30 0.035 130); box-shadow: 0 6px 18px rgba(0,0,0,0.20); border: 1px solid var(--rule);"
    aria-label={`E-Mail schreiben an ${CONTACT.emailDisplay}`}
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="m22 6-10 7L2 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>

  {/* Telefon - primär, dunkel oliv */}
  <a
    href={CONTACT.phoneHref}
    class="fab-phone flex items-center gap-2.5 rounded-full transition-transform duration-150 active:scale-95"
    style="height: 56px; padding: 0 20px 0 18px; background: oklch(0.30 0.035 130); color: #ffffff; box-shadow: 0 8px 22px rgba(0,0,0,0.28);"
    aria-label={`Anrufen: ${CONTACT.phoneDisplay}`}
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="font-sans font-semibold text-[13px] tracking-[0.04em]">Reservieren</span>
  </a>
</div>
