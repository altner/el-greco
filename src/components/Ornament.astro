---
// Decorative olive-branch ornament for page footer
---

<div class="h-[22px] mt-2.5 flex items-center justify-center gap-2" aria-hidden="true">
  <!-- Left branch -->
  <div class="flex items-center gap-1 flex-row-reverse">
    <span class="ornament-end"></span>
    <div class="flex gap-[5px] items-center">
      <span class="ornament-leaf"></span>
      <span class="ornament-leaf-lg"></span>
      <span class="ornament-leaf"></span>
      <span class="ornament-leaf-lg"></span>
      <span class="ornament-leaf"></span>
    </div>
    <span class="ornament-stem"></span>
  </div>

  <!-- Center diamond -->
  <span class="ornament-center"></span>

  <!-- Right branch -->
  <div class="flex items-center gap-1">
    <span class="ornament-stem"></span>
    <div class="flex gap-[5px] items-center">
      <span class="ornament-leaf"></span>
      <span class="ornament-leaf-lg"></span>
      <span class="ornament-leaf"></span>
      <span class="ornament-leaf-lg"></span>
      <span class="ornament-leaf"></span>
    </div>
    <span class="ornament-end"></span>
  </div>
</div>
