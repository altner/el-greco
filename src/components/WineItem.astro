---
interface Props {
  number?: string;
  name: string;
  allergens?: string;
  price: string;
  type?: string;
  character?: string;
  pairing?: string;
}
const { number, name, allergens, price, type, character, pairing } = Astro.props;
---

<div class="mb-4 last:mb-0 pb-4 last:pb-0 border-b last:border-b-0" style="border-color: var(--rule);">
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1 min-w-0">
      <div class="flex items-baseline gap-2 flex-wrap">
        <span
          class="font-serif font-semibold text-[19px] leading-[1.08]"
          style="color: var(--ink);"
        >
          {number && <span class="mr-0.5">{number}.</span>}{name}
        </span>
        {allergens && (
          <span
            class="font-sans font-medium text-[11.5px] tracking-[0.1em] uppercase"
            style="color: var(--ink-mute);"
          >
            {allergens}
          </span>
        )}
      </div>
      {type && (
        <p class="font-serif font-medium text-[18px] mt-1.5 leading-[1.35]" style="color: var(--ink-soft);">
          {type}
        </p>
      )}
      {character && (
        <p class="font-serif font-medium text-[17px] leading-[1.35]" style="color: var(--ink-soft);">
          {character}
        </p>
      )}
      {pairing && (
        <p class="font-serif font-medium text-[17px] leading-[1.35]" style="color: var(--ink-soft);">
          {pairing}
        </p>
      )}
    </div>
    <span
      class="font-serif font-semibold text-[18px] whitespace-nowrap text-right flex-none"
      style="color: var(--ink); font-variant-numeric: tabular-nums; min-width: 7rem;"
    >
      {price}
    </span>
  </div>
</div>
