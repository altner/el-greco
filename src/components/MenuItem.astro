---
interface Props {
  number: string;
  name: string;
  price: string;
  allergens?: string;
  description?: string;
  vegetarian?: boolean;
  badge?: 'house' | 'share' | 'popular';
  number?: string;
}

const {
  number,
  name,
  price,
  allergens,
  description,
  vegetarian = false,
  badge,
} = Astro.props;
---

<div class="grid items-baseline gap-x-3" style="grid-template-columns: 24px 1fr auto;">
  <!-- Number -->
  <span
    class="font-serif italic text-[13px] text-right pt-px"
    style="color: var(--ink-mute); font-feature-settings: 'lnum';"
  >
    {number}
  </span>

  <!-- Body column -->
  <div class="min-w-0">
    <!-- Name row with dotted leader -->
    <div class="flex items-baseline flex-nowrap min-w-0 gap-2">
      <span
        class="font-sans font-semibold text-[15px] whitespace-nowrap flex-none tracking-[0.005em]"
        style="color: var(--ink);"
      >
        {name}
      </span>
      {allergens && (
        <span
          class="font-sans font-medium text-[9.5px] tracking-[0.12em] uppercase whitespace-nowrap flex-none -translate-y-px"
          style="color: var(--ink-mute);"
        >
          {allergens}
        </span>
      )}
      <span class="leaders"></span>
    </div>

    <!-- Badge row -->
    {badge && (
      <div class="flex gap-1.5 mt-1 flex-wrap">
        {badge === 'house' && (
          <span
            class="inline-flex items-center gap-[5px] font-sans text-[9.5px] font-semibold tracking-[0.14em] uppercase px-2 py-[3px] rounded-full leading-none whitespace-nowrap"
            style="background: oklch(0.93 0.04 50); color: var(--terra); border: 1px solid oklch(0.85 0.05 50);"
          >
            <span class="w-[4.5px] h-[4.5px] rounded-full bg-current inline-block"></span>
            Empfehlung des Hauses
          </span>
        )}
        {badge === 'share' && (
          <span
            class="inline-flex items-center gap-[5px] font-sans text-[9.5px] font-semibold tracking-[0.14em] uppercase px-2 py-[3px] rounded-full leading-none whitespace-nowrap"
            style="background: oklch(0.93 0.035 25); color: oklch(0.45 0.10 25); border: 1px solid oklch(0.85 0.045 25);"
          >
            <span class="w-[4.5px] h-[4.5px] rounded-full bg-current inline-block"></span>
            Zum Teilen
          </span>
        )}
        {badge === 'popular' && (
          <span
            class="inline-flex items-center gap-[5px] font-sans text-[9.5px] font-semibold tracking-[0.14em] uppercase px-2 py-[3px] rounded-full leading-none whitespace-nowrap"
            style="background: oklch(0.94 0.03 130); color: var(--olive-700); border: 1px solid oklch(0.85 0.04 130);"
          >
            <span class="w-[4.5px] h-[4.5px] rounded-full bg-current inline-block"></span>
            Beliebt
          </span>
        )}
      </div>
    )}

    <!-- Description / meta line -->
    {(description || vegetarian) && (
      <p
        class="mt-[3px] font-serif italic font-normal text-[14px] leading-[1.4]"
        style="color: var(--ink-soft); max-width: 54ch;"
      >
        {vegetarian && (
          <span class="veg-marker" style="color: var(--veg); font-style: italic; font-weight: 500; letter-spacing: 0.02em;">
            vegetarisch
          </span>
        )}
        {vegetarian && description && (
          <span class="mx-1.5 opacity-70" style="color: var(--ink-mute);">·</span>
        )}
        {description && <span set:html={description} />}
      </p>
    )}
  </div>

  <!-- Price -->
  <span
    class="font-sans font-medium text-[15px] whitespace-nowrap tracking-[0.01em]"
    style="color: var(--ink); font-variant-numeric: tabular-nums;"
  >
    {price}
  </span>
</div>
