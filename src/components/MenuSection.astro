---
interface Props {
  title: string;
  quantity?: string;
}
const { title, quantity } = Astro.props;
---

<div class="mb-16 last:mb-0">
  <!-- Section heading with rule -->
  <div class="flex items-baseline gap-3 mb-3">
    <span
      class="font-serif font-semibold text-[21px] whitespace-nowrap leading-none tracking-[0.01em]"
      style="color: var(--olive-900);"
    >
      {title}
    </span>
    <span class="section-rule"></span>
    {quantity && (
      <span
        class="font-sans text-[11px] tracking-[0.1em] whitespace-nowrap flex-none"
        style="color: var(--ink-mute);"
      >
        {quantity}
      </span>
    )}
  </div>

  <!-- Items -->
  <div class="flex flex-col gap-[12px]">
    <slot />
  </div>
</div>
