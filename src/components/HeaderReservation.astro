---
import { CONTACT } from '../data/contact';
---

<div class="header-reservation hidden lg:block">
  <aside class="reserve-panel" aria-label="Reservieren">
    <div class="reserve-title">
      <span>Reservieren</span>
    </div>
    <div class="reserve-actions">
      <a
        href={CONTACT.phoneHref}
        class="reserve-link"
        aria-label={`Anrufen: ${CONTACT.phoneDisplay}`}
      >
        <i class="ti ti-phone" aria-hidden="true"></i>
        <span>{CONTACT.phoneDisplay}</span>
      </a>
      <a
        href={CONTACT.emailHref}
        class="reserve-link"
        aria-label={`E-Mail: ${CONTACT.emailDisplay}`}
      >
        <i class="ti ti-mail" aria-hidden="true"></i>
        <span>{CONTACT.emailDisplay}</span>
      </a>
    </div>
  </aside>
</div>

<style>
  .header-reservation {
    position: absolute;
    top: 24px;
    right: 40px;
    z-index: 20;
  }

  .reserve-panel {
    width: 224px;
    padding: 13px 15px 14px;
    background: rgba(22, 33, 19, 0.68);
    box-shadow: 0 14px 34px rgba(0,0,0,0.16);
    backdrop-filter: blur(8px);
  }

  .reserve-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 9px;
    color: #ffffff;
    font-family: Manrope, system-ui, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .reserve-actions {
    display: grid;
    gap: 6px;
  }

  .reserve-link {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    min-width: 0;
    color: rgba(255,255,255,0.84);
    font-family: Manrope, system-ui, sans-serif;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
  }

  .reserve-link i {
    font-size: 15px;
    color: rgba(255,255,255,0.86);
  }

  .reserve-link span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reserve-link:hover {
    color: #ffffff;
  }
</style>
