---
interface Props {
  id: string;
  title: string;
  kicker?: string;
  note?: string;
  footnote?: boolean;
}
const { id, title, kicker, note, footnote = true } = Astro.props;
---

<section
  {id}
  class="py-14 px-4 md:scroll-mt-[48px]"
  style="background: transparent;"
>
  <div class="max-w-4xl mx-auto">
    <div
      class="overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.25)]"
      style="background: var(--paper);"
    >
      <!-- Section title -->
      <div class="px-8 md:px-14 pt-8 pb-0">
        <h2
          class="font-serif font-medium italic text-center leading-tight mb-1"
          style="font-size: clamp(24px, 4vw, 34px); color: var(--olive-900); letter-spacing: 0.005em;"
          set:html={title}
        />
        {kicker && (
          <p
            class="text-center text-[10px] tracking-[0.38em] uppercase mb-2.5"
            style="color: var(--ink-mute);"
          >
            {kicker}
          </p>
        )}
        <div class="w-10 h-px mx-auto mb-5" style="background: var(--olive-500);"></div>
        {note && (
          <p
            class="text-center font-serif italic text-[15px] mb-6 -mt-1"
            style="color: var(--ink-soft);"
            set:html={note}
          />
        )}
      </div>

      <!-- Content slot -->
      <div class="px-8 md:px-14 pb-12">
        <slot />
      </div>

    </div>
  </div>
</section>
